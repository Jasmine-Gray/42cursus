              "});",
              "pm.test('Error code is INVALID_PAYLOAD', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('error');",
              "    pm.expect(jsonData.error.code).to.eql('INVALID_PAYLOAD');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06. PUT /users/me/avatar (未認証 -> 401)",
