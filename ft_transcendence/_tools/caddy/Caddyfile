# 開発用リバースプロキシ（https://localhost:8443 → compose.yaml の proxy サービス）
#
# 契約（_docs/spec/api/openapi.yaml）のパスに /api prefix は無いため、
# バックエンド行きは契約のトップレベルパスで振り分ける。
# 契約にパスを追加したら、この @backend マッチャにも追記する。
# 同じ Wi-Fi の別端末から入るときは .env に LAN_HOST=<この PC の IP> を書く（compose.yaml が proxy に渡す）。
# tls internal は IP にも証明書を出す。端末側は初回に警告を許可するか、make ca-cert の root.crt を信頼させる。
{
	# ブラウザが IP 直打ちで来ると SNI を送らない。Docker NAT で Caddy から見た宛先はコンテナ IP なので、
	# SNI なしの接続に使う証明書を LAN_HOST のものに固定する（無いと TLS "internal error" で落ちる）。
	default_sni {$LAN_HOST:127.0.0.1}
}

localhost, {$LAN_HOST:127.0.0.1} {
	tls internal

	@backend {
		path /health /auth/* /users /users/* /invites /invites/* /rooms /rooms/* /games/* /friends /friends/* /socket /socket/* /uploads/*
		not header Accept *text/html*
	}
	handle @backend {
		reverse_proxy backend:4000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
